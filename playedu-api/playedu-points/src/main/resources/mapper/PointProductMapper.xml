<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xyz.playedu.points.mapper.PointProductMapper">

    <resultMap id="pointProductResultMap" type="xyz.playedu.points.domain.PointProduct">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="points_price" property="pointsPrice"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="paginate" resultMap="pointProductResultMap">
        SELECT id, name, points_price, status, created_at, updated_at
        FROM point_products
        <where>
          <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
          </if>
          <if test="status != null">
            AND status = #{status}
          </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="paginateCount" resultType="long">
        SELECT COUNT(*)
        FROM point_products
        <where>
          <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
          </if>
          <if test="status != null">
            AND status = #{status}
          </if>
        </where>
    </select>
</mapper>
