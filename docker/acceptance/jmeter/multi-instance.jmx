            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">X-Forwarded-For</stringProp>
              <stringProp name="Header.value">198.51.100.40</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
